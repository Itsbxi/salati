<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_general" />

            <LinearLayout
                android:id="@+id/row_language"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/language" />

                <TextView
                    android:id="@+id/val_language"
                    style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_location"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/location" />

                <TextView
                    android:id="@+id/val_location"
                    style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_method"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/calc_method" />

                <TextView
                    android:id="@+id/val_method"
                    style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_school"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/asr_calc" />

                <TextView
                    android:id="@+id/val_school"
                    style="@style/SettingValue" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_reminders" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/reminders_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/toggles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_sound" />

            <LinearLayout style="@style/SettingRow">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/sound" />

                <TextView
                    android:id="@+id/val_sound"
                    style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_choose_sound"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/choose_file" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_sound"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:text="@string/test_call" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/section_reliability" />

            <LinearLayout
                android:id="@+id/row_battery"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/battery_settings" />

                <TextView
                    style="@style/SettingValue"
                    android:text="@string/battery_settings_hint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_notif"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/notif_settings" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
